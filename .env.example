TRADING_SCANNER_SCAN_INTERVAL_HOURS=1
TRADING_SCANNER_CANDLE_INTERVAL=1h
TRADING_SCANNER_CANDLE_HISTORY=300
TRADING_SCANNER_SYMBOLS_FILE=config/symbols.txt
TRADING_SCANNER_LOGGING_LEVEL=INFO

# Required by the hourly signal pipeline (trading_scanner.signals).
# Local SQLite only -- hosted Turso is no longer supported (2026-08-20).
# Use "file:local.db" for local development, "file:/path/to/prod.db" in production.
TRADING_SCANNER_TURSO_URL=
# No longer used (kept so old .env files with it set don't error) -- there is
# no hosted database to authenticate against anymore.
TRADING_SCANNER_TURSO_AUTH_TOKEN=

# Optional: falls back to console logging when unset.
TRADING_SCANNER_TELEGRAM_BOT_TOKEN=
TRADING_SCANNER_TELEGRAM_CHAT_ID=

# Optional: broad market index evaluated alongside every stock signal, for
# noise context only (never used to suppress a signal). Defaults to NIFTY 50.
# Set to empty to disable index tracking entirely.
TRADING_SCANNER_INDEX_SYMBOL=^NSEI
